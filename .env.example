# Copy to .env and fill in what you need. Parsing still independently selects local/azure/aws
# (Azure Document Intelligence, AWS Textract each do something a local library can't). Embedding,
# vector storage and reranking are local-first infra with one escape hatch each (openai, n/a,
# cohere) — see docs/adapters.md and ADR-029 in docs/design-decisions.md. Generation picks a
# model vendor directly (openai/anthropic/google), independent of the parsing cloud accounts.

# ---------------------------------------------------------------- stage provider selection
PARSE_PROVIDER=local
EMBED_PROVIDER=local
VECTORSTORE_PROVIDER=local
RERANK_PROVIDER=local
LLM_PROVIDER=local

# single | hybrid_escalate | hybrid_merge | race
PARSE_STRATEGY=hybrid_escalate
PARSE_QUALITY_THRESHOLD=0.72

# ------------------------------------------------------------------------------------ local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
LOCAL_EMBEDDING_DIMS=768
LOCAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_CHEAP_MODEL=llama3.2:3b

PGVECTOR_DSN=postgresql+psycopg://sentinelapp:sentinel@localhost:5432/sentinel
PGVECTOR_COLLECTION=ops_knowledge
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------------ Azure
# Parsing only — Azure Document Intelligence. Azure OpenAI / Azure AI Search are gone from this
# repo (ADR-029); see .archive/providers/ if you ever need them back.
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=
AZURE_DOC_INTELLIGENCE_MODEL=prebuilt-layout
# When DEBUG=true, cap Document Intelligence analysis at this many pages (per-page billing;
# a free-tier resource caps at 2 anyway). 0 disables the cap. Ignored when DEBUG=false.
AZURE_DI_DEV_PAGE_LIMIT=2

# -------------------------------------------------------------------------------------- AWS
# Parsing only — AWS Textract. Bedrock / OpenSearch are gone from this repo (ADR-029).
AWS_REGION=us-east-1
AWS_PROFILE=

# Required whenever parse_provider=aws (or hybrid escalates to it): Textract's multi-page API
# reads the document from S3, there is no inline-bytes option. Must be in AWS_REGION and
# writable by the caller. Config validation refuses parse_provider=aws without it.
TEXTRACT_S3_BUCKET=my-textract-scratch-bucket
TEXTRACT_S3_PREFIX=sentinel/textract/

# ------------------------------------------------------------------------- inference vendors
# Used by EMBED_PROVIDER=openai, RERANK_PROVIDER=cohere and LLM_PROVIDER=openai/anthropic/google
# respectively. Each is independent — set only the ones you're actually pointing a stage at, and
# leave the rest blank. Config validation refuses selecting a provider whose key is blank.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHEAP_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=1536

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
ANTHROPIC_CHEAP_MODEL=claude-haiku-4-5-20251001

GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-2.5-pro
GOOGLE_CHEAP_MODEL=gemini-2.5-flash

COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# -------------------------------------------------------------------------------- retrieval
RETRIEVE_K=50
RERANK_TOP_N=6
RRF_K=60
MIN_RERANK_SCORE=0.0
USE_MMR=false

CHUNK_STRATEGY=structural
CHUNK_SIZE=550
CHUNK_OVERLAP=60
CONTEXTUAL_CHUNKING=false

# ---------------------------------------------------------------------------------- budgets
NODE_TIMEOUT_S=90
MAX_STEPS=12
MAX_USD_PER_RUN=2.50
KILL_SWITCH=false

# ---------------------------------------------------------------------------- observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LOG_LEVEL=INFO
# Development switch: forces DEBUG logging and cheaper cost/quota-sensitive cloud paths.
# Set false wherever real cost or full corpus coverage matters.
DEBUG=false
ONLINE_EVAL_SAMPLE_RATE=0.1
