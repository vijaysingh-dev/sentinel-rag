# Copy to .env and fill in what you need. Every stage independently selects local, azure or aws,
# so a valid setup can mix them — parse with Azure, embed with Bedrock, rerank locally.

# ---------------------------------------------------------------- stage provider selection
PARSE_PROVIDER=local
EMBED_PROVIDER=local
VECTORSTORE_PROVIDER=local
RERANK_PROVIDER=local
LLM_PROVIDER=local

# single | hybrid_escalate | hybrid_merge | race
PARSE_STRATEGY=hybrid_escalate
PARSE_QUALITY_THRESHOLD=0.72

# ------------------------------------------------------------------------------------ local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
LOCAL_EMBEDDING_DIMS=768
LOCAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_CHEAP_MODEL=llama3.2:3b

PGVECTOR_DSN=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel
PGVECTOR_COLLECTION=ops_knowledge
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------------ Azure
# Leave the API keys blank to authenticate with managed identity via `az login` — preferred,
# because it keeps secrets out of config entirely.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_CHAT_CHEAP_DEPLOYMENT=gpt-4o-mini
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_EMBEDDING_DIMS=3072

AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=
AZURE_DOC_INTELLIGENCE_MODEL=prebuilt-layout

AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=sentinel-knowledge
AZURE_SEARCH_SEMANTIC_CONFIG=semantic-config

# -------------------------------------------------------------------------------------- AWS
AWS_REGION=us-east-1
AWS_PROFILE=

BEDROCK_CHAT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_CHAT_CHEAP_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMS=1024
BEDROCK_RERANK_MODEL=amazon.rerank-v1:0

# Required for multi-page Textract: the async API reads from S3, there is no bytes option.
TEXTRACT_S3_BUCKET=
TEXTRACT_S3_PREFIX=sentinel/textract/

OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=sentinel-knowledge
OPENSEARCH_SERVERLESS=true

# -------------------------------------------------------------------------------- retrieval
RETRIEVE_K=50
RERANK_TOP_N=6
RRF_K=60
MIN_RERANK_SCORE=0.0
USE_MMR=false

CHUNK_STRATEGY=structural
CHUNK_SIZE=550
CHUNK_OVERLAP=60
CONTEXTUAL_CHUNKING=false

# ---------------------------------------------------------------------------------- budgets
NODE_TIMEOUT_S=90
MAX_STEPS=12
MAX_USD_PER_RUN=2.50
KILL_SWITCH=false

# ---------------------------------------------------------------------------- observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LOG_LEVEL=INFO
ONLINE_EVAL_SAMPLE_RATE=0.1
