# Copy to web/.env to point the Agent Chat UI at Sentinel's RCA graph.
# Serve the graph with `make chat-server` (LangGraph dev server on :2024,
# graph id "rca" from ../langgraph.json).
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=rca
NEXT_PUBLIC_AUTH_SCHEME=
LANGSMITH_API_KEY=
