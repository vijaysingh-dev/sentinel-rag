# Copy to web/.env to point the Agent Chat UI at Sentinel's chat mediator.
# Serve it with `make chat-api` (sentinel/chat/api.py, FastAPI on :8093).

CHAT_API_URL=http://localhost:8093

# Platform status panel — system-monitor and incident-generator (make demo-up).
MONITOR_API_URL=http://localhost:8091
INCIDENT_API_URL=http://localhost:8092
