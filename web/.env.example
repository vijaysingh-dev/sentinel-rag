# Sentinel chat mediator — proxied server-side the same way as MONITOR_API_URL/INCIDENT_API_URL
# below, since sentinel/chat/api.py sets no CORS headers of its own (it wasn't built to be
# fetched from a browser origin directly — see web/src/app/api/chat).
# Default matches sentinel/core/config.py's chat_api_port; override only if you've remapped it.
CHAT_API_URL=http://localhost:8093

# Platform status panel — proxied server-side the same way as CHAT_API_URL above, since neither
# service sets CORS headers (see web/src/app/api/monitor and .../incidents).
# Defaults match app/otel-demo/compose.extras.yaml's published ports; override only if you've
# remapped them.
MONITOR_API_URL=http://localhost:8091
INCIDENT_API_URL=http://localhost:8092
